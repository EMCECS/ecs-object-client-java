###
### Template file for test configuration parameters.
### Copy to "test.properties" and configure for your environment.
###

## Your S3 Access Key
s3.access_key=<user>@<domain>

## Your S3 Secret Key
s3.secret_key=<secretkey>

## Endpoint to the S3 Access Point
s3.endpoint=http[s]://<ecshost>[:9020|:9021]

## Specified if the use is an IAM user
s3.iam_user=false


### STS test part (Dell ECS / ObjectScale)

## STS endpoint for dynamically fetching temporary credentials (recommended)
## When set, S3TempCredentialsTest will use STS AssumeRole to obtain fresh credentials at runtime
## For ECS: https://<ecshost>:4443/sts
#sts.endpoint=https://<ecshost>:4443/sts

## IAM endpoint for creating roles/users for AssumeRole tests
## For ECS: https://<ecshost>:4443/iam
#iam.endpoint=https://<ecshost>:4443/iam

## Static temporary credentials (legacy, used as fallback if sts.endpoint is not set)
## Your S3 Access Key for sts
#s3.temp_access_key=<user>@<domain>

## Your S3 Secret Key for sts
#s3.temp_secret_key=<secretkey>

## Uncomment this to add your sts token
#s3.security_token=<securityToken>


## Uncomment to enable vhost-style requests (including the namespace)
#enableVhost=true

## Uncomment to disable smart client (with a load balancer or a single node)
#disableSmartClient=true

## Optional -- HTTP proxy.  Useful for debugging.
#http.proxyUri=http://localhost:8888
